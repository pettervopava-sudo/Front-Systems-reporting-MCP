# Front Systems API credentials — template.
# Copy to .env and fill in real values. Never commit .env.
#
#   cp .env.example .env
#
# Where each value comes from:
#
# FRONT_SYSTEMS_SUBSCRIPTION_KEY
#   developer.frontsystems.com -> sign in -> your Profile -> subscription.
#   One per company, shared across all your integrations.
#   Sent as header: Ocp-Apim-Subscription-Key
#
# FRONT_SYSTEMS_API_KEY
#   portal.frontsystems.no (Backoffice) -> Admin -> Integration users.
#   One per integration is best practice, so it can be revoked alone.
#   Shown only once at creation — save it immediately.
#   Sent as header: x-api-key
#
# FRONT_SYSTEMS_BASE_URL
#   Shown on the API details page in the developer portal once signed in.
#   Confirmed during the discovery spike.

FRONT_SYSTEMS_SUBSCRIPTION_KEY=
FRONT_SYSTEMS_API_KEY=
FRONT_SYSTEMS_BASE_URL=
